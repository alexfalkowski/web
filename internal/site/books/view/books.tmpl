{{ define "content" }}
  <article>
    <h2>{{.Localizer.Text "books.heading"}}</h2>
    <blockquote>
      {{.Localizer.Text "books.quote"}}
      <footer>
        <cite>— Margaret Fuller</cite>
      </footer>
    </blockquote>
    <p>
      {{.Localizer.Text "books.introduction"}}
    </p>
    <table>
      <thead>
        <tr>
          <th scope="col">{{.Localizer.Text "books.column.title"}}</th>
          <th scope="col">{{.Localizer.Text "books.column.author"}}</th>
          <th scope="col">{{.Localizer.Text "books.column.topics"}}</th>
          <th scope="col">{{.Localizer.Text "books.column.note"}}</th>
          <th scope="col">{{.Localizer.Text "books.column.link"}}</th>
        </tr>
      </thead>
      <tbody>
        {{range .Model.Books}}
          <tr>
            <td>{{.Title}}</td>
            <td>{{.Author}}</td>
            <td>{{$.Localizer.Text .Topics}}</td>
            <td>{{$.Localizer.Text .Note}}</td>
            <td><a href="{{.Link}}" target="_blank" rel="noopener noreferrer">{{.Link}}</a></td>
          </tr>
        {{end}}
      </tbody>
    </table>
  </article>
{{ end }}
