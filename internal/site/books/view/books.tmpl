{{ define "content" }}
  <section class="books-page">
    <header class="page-header">
      <div>
        <h1>{{.Localizer.Text "books.heading"}}</h1>
        <p class="introduction">{{.Localizer.Text "books.introduction"}}</p>
      </div>
      <blockquote class="quote">
        <p>{{.Localizer.Text "books.quote"}}</p>
        <footer>
          <cite>— Margaret Fuller</cite>
        </footer>
      </blockquote>
    </header>
    <div class="book-grid">
      {{range .Model.Books}}
        <article class="card book-card">
          <div class="card-body">
            <div class="book-topics">{{$.Localizer.Text .Topics}}</div>
            <h2 class="card-title">{{.Title}}</h2>
            <div class="book-author">{{.Author}}</div>
            <p class="book-note">{{$.Localizer.Text .Note}}</p>
            <div class="card-actions">
              <a class="btn btn-outline" href="{{.Link}}" target="_blank" rel="noopener noreferrer"><span>{{$.Localizer.Text "books.view"}}</span> <span aria-hidden="true">↗</span></a>
            </div>
          </div>
        </article>
      {{end}}
    </div>
  </section>
{{ end }}
